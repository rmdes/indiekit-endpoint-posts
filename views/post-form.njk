{% extends "form.njk" %}

{% block fieldset %}
  {{ input({
    name: "type",
    type: "hidden",
    value: type
  }) | indent(2) }}

  {{ input({
    name: "postType",
    type: "hidden",
    value: postType
  }) | indent(2) }}

{% for name, field in fields %}
  {% include "post-types/" + name + "-field.njk" ignore missing %}
{% endfor %}

  {{ checkboxes({
    name: "mp-syndicate-to",
    values: properties["mp-syndicate-to"],
    fieldset: {
      legend: __("posts.form.mp-syndicate-to.label")
    },
    items: syndicationTargetItems
  }) | indent(2) }}

  {% call details({
    open: showAdvancedOptions,
    summary: __("posts.form.advancedOptions")
  }) %}
    {{ radios({
      fieldset: {
        legend: __("posts.form.published.label")
      },
      name: "publication-date",
      values: fieldData("publication-date").value,
      items: [{
        label: __("posts.form.published.now") if postStatus !== "published" else fieldData("published").value | date("PPPppp", { locale: opts.locale, timeZone: application.timeZone }),
        value: "now",
        checked: true
      }, {
        label: __("posts.form.published.scheduled"),
        value: "scheduled",
        conditional: input({
          classes: "input--width-10",
          name: "published",
          type: "datetime-local",
          label: __("posts.form.published.label")
        })
      }]
    }) }}

    {{ radios({
      inline: true,
      name: "visibility",
      values: properties.visibility,
      fieldset: {
        legend: __("posts.form.visibility.label"),
        optional: true
      },
      items: [{
        label: __("posts.status.public"),
        value: "public"
      }, {
        label: __("posts.status.private"),
        value: "private"
      }, {
        label: __("posts.status.unlisted"),
        value: "unlisted"
      }]
    }) | indent(4) if fields.visibility }}

    {{ checkboxes({
      name: "sensitive",
      values: properties.sensitive,
      fieldset: {
        legend: __("posts.form.sensitive.label")
      },
      items: [{
        label: __("posts.form.sensitive.hint"),
        value: "true",
        conditional: input({
          name: "content-warning",
          value: properties["content-warning"],
          label: __("posts.form.summary.label"),
          optional: true
        })
      }]
    }) | indent(4) }}

    {{ input({
      classes: "input--width-25",
      name: "mp-slug",
      value: fieldData("slug").value,
      label: __("posts.form.mp-slug.label"),
      optional: true
    }) | indent(4) }}

    {{ select({
      name: "layout-intent",
      label: __("posts.form.layout-intent.label"),
      hint: __("posts.form.layout-intent.hint"),
      optional: true,
      items: [
        { text: __("posts.form.layout-intent.default"), value: "", selected: not properties["layout-intent"] },
        { text: __("posts.form.layout-intent.fullwidth"), value: "fullwidth", selected: properties["layout-intent"] === "fullwidth" },
        { text: __("posts.form.layout-intent.minimal"), value: "minimal", selected: properties["layout-intent"] === "minimal" }
      ]
    }) | indent(4) }}

    {{ select({
      name: "pinned",
      label: __("posts.form.pinned.label"),
      optional: true,
      items: [
        { text: __("posts.form.pinned.no"), value: "", selected: not properties.pinned },
        { text: __("posts.form.pinned.yes"), value: "true", selected: properties.pinned === "true" or properties.pinned === true }
      ]
    }) | indent(4) }}

    {{ select({
      name: "ai-text-level",
      label: __("posts.form.ai-text-level.label"),
      optional: true,
      items: [
        { text: __("posts.form.ai-text-level.0"), value: "0", selected: properties["ai-text-level"] === "0" or not properties["ai-text-level"] },
        { text: __("posts.form.ai-text-level.1"), value: "1", selected: properties["ai-text-level"] === "1" },
        { text: __("posts.form.ai-text-level.2"), value: "2", selected: properties["ai-text-level"] === "2" },
        { text: __("posts.form.ai-text-level.3"), value: "3", selected: properties["ai-text-level"] === "3" }
      ]
    }) | indent(4) }}

    {{ select({
      name: "ai-code-level",
      label: __("posts.form.ai-code-level.label"),
      optional: true,
      items: [
        { text: "", value: "" },
        { text: __("posts.form.ai-code-level.0"), value: "0", selected: properties["ai-code-level"] === "0" },
        { text: __("posts.form.ai-code-level.1"), value: "1", selected: properties["ai-code-level"] === "1" },
        { text: __("posts.form.ai-code-level.2"), value: "2", selected: properties["ai-code-level"] === "2" }
      ]
    }) | indent(4) }}

    {{ input({
      classes: "input--width-25",
      name: "ai-tools",
      value: properties["ai-tools"],
      label: __("posts.form.ai-tools.label"),
      hint: __("posts.form.ai-tools.placeholder"),
      optional: true
    }) | indent(4) }}

    {{ input({
      classes: "input--width-25",
      name: "ai-description",
      value: properties["ai-description"],
      label: __("posts.form.ai-description.label"),
      optional: true
    }) | indent(4) }}
  {% endcall %}
{% endblock %}

{% block buttons %}
  <div class="button-group">
    {{ button({
      name: "post-status",
      value: "published",
      text: __("posts.form.update") if postStatus === "published" else __("posts.form.publish")
    }) | indent(4) if not draftMode }}

    {{ button({
      name: "post-status",
      value: "draft",
      classes: "button--secondary",
      text: __("posts.form.updateDraft") if postStatus === "draft" else __("posts.form.publishDraft")
    }) | indent(4) if postStatus !== "published" }}

    {{ prose({
      text: "[" + __("posts.form.cancel") + "](" + postsPath + ")"
    }) | indent(4) }}
  </div>
{% endblock %}